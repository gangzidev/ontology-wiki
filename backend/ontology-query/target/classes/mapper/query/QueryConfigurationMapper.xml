<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ontologywiki.query.mapper.QueryConfigurationMapper">
    <resultMap id="ProposalResult" type="java.util.LinkedHashMap">
        <id property="proposal_id" column="proposal_id" />
        <result property="task_id" column="task_id" />
        <result property="status" column="status" />
        <result property="config_json" column="config_json" javaType="java.lang.String" />
    </resultMap>
    <resultMap id="DatasourceResult" type="java.util.LinkedHashMap">
        <result property="name" column="name" />
        <result property="schema_name" column="schema_name" />
        <result property="db_type" column="db_type" />
        <result property="host" column="host" />
        <result property="port" column="port" />
        <result property="database_name" column="database_name" />
        <result property="jdbc_url" column="jdbc_url" />
        <result property="username" column="username" />
        <result property="password_enc" column="password_enc" />
    </resultMap>
    <select id="selectProposal" resultMap="ProposalResult">
        select proposal_id, task_id, status, config_json
        from ontology_proposal where proposal_id = #{proposalId}
    </select>
    <select id="selectTaskDatasource" resultMap="DatasourceResult">
        select datasource.name, datasource.schema_name, datasource.db_type, datasource.host, datasource.port,
               datasource.database_name, datasource.jdbc_url, datasource.username, datasource.password_enc
        from analysis_task task
        left join ontology_datasource datasource on datasource.datasource_id = task.source_id
        where task.task_id = #{taskId}
    </select>
</mapper>
